flowchart TD
    Start([User Clicks 'Forgot Password?' in LoginForm]) --> InputEmail[Enter Email Address<br/>src/features/auth/components/LoginForm.tsx]
    InputEmail --> SubmitReset[Submit Reset Request]
    
    SubmitReset --> ServerThrottle{Server RPC Rate Check<br/>request_password_reset RPC}
    ServerThrottle -- Throttled < 60s --> ShowCooldown[Display Cooldown Notice<br/>Must wait 60s between submissions]
    ShowCooldown --> InputEmail
    
    ServerThrottle -- Allowed --> PersistReq[(Insert password_reset_requests<br/>status='PENDING', no tokens/passwords stored<br/>Append event to security_events)]
    
    PersistReq --> AuthDispatch[Call Supabase Auth resetPasswordForEmail<br/>Redirect URL: /reset-password]
    
    AuthDispatch --> DeliverCheck{SMTP Delivery Available?}
    
    DeliverCheck -- Configured & Sent --> GenericMsg[Display Generic Confirmation<br/>'If an account matches, a reset link will arrive...']
    DeliverCheck -- Unavailable / Error --> SupportFallback[Display Contact Administrator Support Card<br/>Using get_public_support_contacts RPC]
    
    GenericMsg --> InboxCheck{User Clicks Recovery Link in Email}
    SupportFallback --> ContactAdmin[User Reaches Configured Support Channel]
    
    InboxCheck -- Valid Token Session --> OpenResetPage[Open /reset-password<br/>Valid Auth Recovery Session Verified]
    InboxCheck -- Expired / Invalid Token --> ExpiredNotice[Display Expired/Invalid Token Warning<br/>Actions: Request New Link / Back to Sign In]
    ExpiredNotice --> InputEmail
    
    OpenResetPage --> EnterNewPass[Enter New Password >= 8 chars & Confirm<br/>src/features/auth/pages/ResetPasswordPage.tsx]
    EnterNewPass --> UpdatePass[Call supabase.auth.updateUser with new password]
    
    UpdatePass --> UpdateDB[(Supabase Auth Updates auth.users.encrypted_password<br/>bcrypt hash + salt securely stored by Supabase Auth<br/>public.profiles untouched)]
    
    UpdateDB --> SuccessSignOut[Sign Out All Active Sessions & Show Success]
    SuccessSignOut --> LoginRedirect([Redirect User to /login with Success Banner])
