    STAFF --> I4
    ADMIN --> I1
    ADMIN --> I2
    ADMIN --> I4
    ADMIN --> I5
    SUPER --> I1
    SUPER --> I2
    SUPER --> I4
    SUPER --> I5
    SUPER --> I6

