        L4["Unlock Staff Account (unlock_account)"]
        L5["Unlock Admin Account (unlock_account)"]
    end

    subgraph InventoryOperations["Inventory & Finalization Operations"]
        I1["Create & Edit Active Daily Inventory"]
        I2["Finalize Daily Inventory (finalize_daily_inventory)"]
