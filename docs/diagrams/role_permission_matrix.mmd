        I5["Admin Stage 1 Review (admin_review_correction_request)"]
        I6["Super Admin Final Approval & Apply (apply_approved_daily_inventory_correction)"]
    end

    subgraph ProfileOperations["Profile & Role Governance"]
        P1["Update Own Allowed Profile (update_my_profile)"]
        P2["Publish Public Support Contacts & Links"]
        P3["Promote/Demote Users & Change Roles"]
        P4["Sole Super Admin Break-Glass Recovery"]
    end

