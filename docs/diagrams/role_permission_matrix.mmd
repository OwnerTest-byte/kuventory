flowchart TD
    subgraph Roles["Canonical User Roles"]
        ANON["Anonymous (anon)"]
        STAFF["Staff (staff)"]
        ADMIN["Admin (admin)"]
        SUPER["Super Admin (super_admin)"]
    end

    subgraph AuthOperations["Authentication & Security Operations"]
        L1["Submit Login Credentials"]
        L2["Read Public Support Contacts (get_public_support_contacts)"]
